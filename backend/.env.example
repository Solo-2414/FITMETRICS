PORT=5000
CLIENT_URL=http://localhost:5173
DB_PLAN_LIMIT_MB=500

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SECRET key (service_role / sb_secret_...). NEVER put this in the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: direct Postgres access (not used by the app right now)
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Brevo SMTP primary
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login
SMTP_PASS=your-brevo-smtp-key
# Optional Mailjet SMTP backup
SMTP2_HOST=in-v3.mailjet.com
SMTP2_PORT=587
SMTP2_USER=your-mailjet-api-key
SMTP2_PASS=your-mailjet-secret-key
MAIL_FROM="FITMETRICS <verified-sender@example.com>"
EMAIL_LOGO_URL="https://your-domain.example/logo.png"

# Email worker retry and scheduled-job settings
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_MINUTES=5
EMAIL_DAILY_LIMIT_PRIMARY=280
EMAIL_DAILY_LIMIT_BACKUP=180
EMAIL_TRANSACTIONAL_RESERVE=100
EMAIL_BULK_PER_MINUTE=20
EMAIL_DAILY_LIMIT=400
CRON_TIMEZONE=Asia/Manila

# PayMongo (use test keys first)
PAYMONGO_SECRET_KEY=sk_test_your-paymongo-secret-key
PAYMONGO_WEBHOOK_SECRET=your-paymongo-webhook-secret
CHECKIN_QR_SECRET=replace-with-a-long-random-secret
# Used to sign the rotating gym entrance QR check-in token.

# 32-byte base64 or 64-character hex key for encrypted QR registration drafts
REGISTRATION_ENC_KEY=
ALLOW_PAYMENT_SIMULATION=false
